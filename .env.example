# Operator-specific fleet settings. Copy to .env and fill in:
#
#     cp .env.example .env
#
# .env is gitignored. Real environment variables override .env, and an explicit
# value in the fleet YAML overrides both. Point ARMORY_ENV_FILE at another path
# to use a different file.

# SSH account used to reach every workstation.
# Defaults to your local username when unset.
ARMORY_SSH_USER=your-username

# Workstation addresses are built as <base_ip>.<ip_offset + workstation id>,
# so base 10.0.0 with offset 200 puts workstation 1 at 10.0.0.201.
ARMORY_SSH_BASE_IP=10.0.0
ARMORY_SSH_IP_OFFSET=200

# Lab checkout on each workstation -- the same path the workstation's ~/.bashrc
# calls PIPER_DOCKER_DIR. Its parent must contain user_data/ and assets/; those
# are bind-mounted into the container at boot. Required for Boot and for fetching
# episode data. Read from here, not from the workstation's ~/.bashrc: that file
# only sets the variable for interactive shells.
ARMORY_PIPER_DOCKER_DIR=/path/to/CS4803ARM_Lab/docker

# Boot checks that the piper workspace overlay actually carries the client node
# and rebuilds that one package when it does not (on a single workstation --
# user_data/piper_ros is one shared checkout mounted by the whole fleet). Set to
# false to have boot report a stale overlay instead of building it.
ARMORY_AUTO_BUILD_WORKSPACE=true

# SSH jump host fronting the fleet, and the compute node the tunnel targets.
# Leave ARMORY_TUNNEL_SERVER empty to disable tunnelling.
ARMORY_TUNNEL_SERVER=jump.example.edu
ARMORY_TUNNEL_NODE=node-name
ARMORY_TUNNEL_PORT=8080
# Defaults to ARMORY_SSH_USER when unset.
ARMORY_TUNNEL_USER=your-username

# mediamtx server the workstation webcams publish to. Per-robot stream path is
# <base>/workstation<id>. Required only for the webcam features (TUI "W" key,
# run_real.py --save-videos).
ARMORY_WEBCAM_RTSP_BASE_URL=rtsp://10.0.0.217:8554
